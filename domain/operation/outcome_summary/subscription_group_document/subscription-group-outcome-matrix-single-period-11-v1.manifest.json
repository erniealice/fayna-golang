{
  "profile": {
    "key": "subscription_group_outcome_matrix_single_period_11_v1",
    "binding_job_category_scope": "exact_required",
    "period_cardinality": 1,
    "row_loop": "rows",
    "column_loop": "job_templates",
    "row_column_loop": "cells",
    "max_columns": 63,
    "numbered_slot_pattern": "job_template{n}_",
    "subject_order": "trimmed_display_name_unicode_lower_then_id_asc",
    "subject_order_owner": "go_post_query_normalization",
    "column_capacity": "numbered_slots_used_by_template_else_unbounded",
    "column_mismatch": "fail_loud_503",
    "profile_mismatch": "fail_loud_503",
    "missing_outcome_display": "blank",
    "occurrence_rule": "any_supported_token_may_be_omitted_or_repeated"
  },
  "scopes": {
    "root": {
      "text": [
        "sheet_title",
        "subscription_group_name_display",
        "price_schedule_name_display",
        "job_template_phase_name_display",
        "period_name_display",
        "client_name_label",
        "job_template_count"
      ],
      "numbered_text": ["name_display"],
      "style": {}
    },
    "job_templates": {
      "text": ["job_template_name_display", "job_template_number"],
      "style": {}
    },
    "rows": {
      "text": ["row_label_display", "row_band_label", "row_client_label"],
      "numbered_text": ["scaled_label"],
      "style": {"row_bold": "bold"},
      "numbered_style": {"fill_hex": "fill", "text_hex": "color"}
    },
    "cells": {
      "text": ["cell_scaled_label"],
      "style": {"cell_fill_hex": "fill", "cell_text_hex": "color"}
    }
  },
  "style_values": {
    "row_bold": ["true", "false"],
    "fill_hex": ["FFFFFF", "FFFF00", "008000", "0000FF"],
    "text_hex": ["000000", "FFFFFF"]
  }
}
